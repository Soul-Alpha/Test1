storage/*.db
models/**/*.pkl

# Large generated research/runtime artifacts
storage/olympus/**/*.jsonl
storage/olympus/**/*.json
storage/olympus_research/**/*.jsonl
storage/olympus_research/**/*.json

# Temporary files
*.tmp
*.bak
