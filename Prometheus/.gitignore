# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local env files
.env
.env.*

# Runtime logs and pids
*.log
*.pid

# Runtime state files
live_bot/bot_status.json
live_bot/hermes_status.json
