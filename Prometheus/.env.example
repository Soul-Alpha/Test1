# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no extra config needed)
PROMETHEUS_DATABASE_URL=sqlite:///storage/prometheus.db

# PostgreSQL example:
# PROMETHEUS_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/prometheus

# ── Logging ───────────────────────────────────────────────────────────────────
PROMETHEUS_LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── UI ────────────────────────────────────────────────────────────────────────
UI_PORT=8501

# ── Live Data (optional — requires ccxt) ─────────────────────────────────────
# EXCHANGE_NAME=binance
# EXCHANGE_API_KEY=your_api_key_here
# EXCHANGE_SECRET=your_secret_here

# ── GPU (optional — requires CUDA + torch) ───────────────────────────────────
# PROMETHEUS_GPU_ENABLED=true
